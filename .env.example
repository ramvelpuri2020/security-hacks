# --- Optional but recommended: live CVE lookup ---
# Tavily Search API — https://tavily.com (1,000 free credits/month)
TAVILY_API_KEY=

# --- Optional but recommended: AI patch generation ---
# OpenAI-compatible endpoint. Defaults below point at Alibaba Qwen (DashScope).
# Either LLM_API_KEY or DASHSCOPE_API_KEY works (DashScope's SDK uses the latter).
# Get a Qwen key: https://bailian.console.aliyun.com
# Alternative: OpenRouter (https://openrouter.ai) — base url https://openrouter.ai/api/v1
LLM_API_KEY=
DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
# Per-finding LLM call timeout in ms. Defaults to 45s — thinking models
# (qwen3.6-flash) are slow per response, and a too-short budget forces
# deterministic fallback instead of a genuine LLM-written fix.
LLM_TIMEOUT_MS=45000
# Timeout for the universal AI semantic analysis pass (LLM reads the repo's
# source in ANY language and finds vulnerabilities). Default 120s.
LLM_ANALYSIS_TIMEOUT_MS=120000

# --- Server ---
PORT=4000

# --- Render Workflows (optional — enables the "Best Use of Render" path) ---
# Lets /api/scan/workflow kick off a scan as a managed Render Workflow task
# run instead of streaming in-process. Requires:
#   1. A workflow service created in Render (workflow/index.js, start cmd:
#      node workflow/index.js) — blueprints don't support workflows yet.
#   2. A Render API key (Dashboard → Account → API Keys).
#   3. The task slug from the task's page in the dashboard, format:
#      {workflow-slug}/{task-name}, e.g. patch-scan/scan_repo
RENDER_API_KEY=
RENDER_WORKFLOW_TASK=

# --- Scan limits (stops giant repos from hanging the demo) ---
MAX_SCAN_BYTES=20000000
MAX_SCAN_FILES=10000
